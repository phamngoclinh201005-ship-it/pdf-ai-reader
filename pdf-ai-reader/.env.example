# Server only. Never commit your real API key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
NUXT_PUBLIC_API_BASE=
NUXT_BACKEND_API_BASE=https://paperflow-api-reif.onrender.com

# Optional runtime overrides for the production server:
# NUXT_GEMINI_API_KEY=your_gemini_api_key_here
# NUXT_GEMINI_MODEL=gemini-2.5-flash

# Optional official Google Cloud Translation Basic v2 (server only).
# Disabled by default. Configure billing/API/quota yourself before opting in.
NUXT_GOOGLE_TRANSLATION_ENABLED=false
# NUXT_GOOGLE_TRANSLATION_API_KEY=your_restricted_cloud_translation_api_key
