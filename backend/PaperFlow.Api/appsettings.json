{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gemini": {
    "Model": "gemini-2.5-flash"
  },
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "PaperFlowDB"
  },
  "Frontend": {
    "Origin": "http://localhost:3000"
  },
  "Auth": {
    "CookieName": "paperflow_session",
    "SessionDays": 7,
    "OtpMinutes": 5
  },
  "Resend": {
    "From": "PaperFlow <onboarding@resend.dev>"
  }
}
